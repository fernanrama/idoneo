# Copiar a frontend/.env.local (Next.js solo lee variables de esta carpeta).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Solo si el agente de ElevenLabs es público. Si es privado, la clave va en el .env del backend.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# No copiar ADMIN_TOKEN al frontend: la validación web está bloqueada hasta
# acordar autorización independiente de asesores. Los secretos de servicio quedan en backend.
