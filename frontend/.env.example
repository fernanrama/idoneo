# Copiar a frontend/.env.local (Next.js solo lee variables de esta carpeta).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Solo si el agente de ElevenLabs es público. Si es privado, la clave va en el .env del backend.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# Modo asesor de demostración (docs/modo-asesor-demo.md): solo servidor, sin NEXT_PUBLIC_.
# Apagado por defecto. Para el pitch, 1 y el mismo token que en el .env del backend.
DEMO_ADVISOR_MODE=0
DEMO_ADVISOR_TOKEN=
# Entrada de la entidad (/admin): solo servidor. ADMIN_TOKEN, el mismo que en el .env del backend;
# ADMIN_LOGIN_CLAVE, la clave que se teclea (12 caracteres o más). Sin ellas, /admin no deja entrar.
# `python backend/scripts/preparar_demo.py` las rellena en local.
API_URL_SERVIDOR=http://localhost:8000
ADMIN_TOKEN=
ADMIN_LOGIN_CLAVE=
