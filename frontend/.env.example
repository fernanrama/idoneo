# Copiar a frontend/.env.local (Next.js solo lee variables de esta carpeta).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Solo si el agente de ElevenLabs es público. Si es privado, la clave va en el .env del backend.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# Solo para el servidor de Next (sin NEXT_PUBLIC_: nunca llega al navegador). Mismo valor que ADMIN_TOKEN
# del .env del backend. Lo usa el botón «Validar perfil» y el reinicio de la demo. Vacío si el backend no lo pide.
ADMIN_TOKEN=
