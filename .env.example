# Copiar a .env y rellenar en local. NUNCA subir .env al repositorio.

# Claude (Anthropic)
ANTHROPIC_API_KEY=
MODEL_EXTRACTOR=claude-sonnet-5-5
MODEL_VERIFICADOR=claude-sonnet-5-5
# Opcionales: esfuerzo por agente (low|medium|high|xhigh|max) y modelo del entrevistador en modo texto.
EFFORT_EXTRACTOR=low
EFFORT_VERIFICADOR=low
# 0 apaga la revisión con Claude del verificador (quedan sus reglas fijas).
VERIFICADOR_CLAUDE=1
MODEL_ENTREVISTADOR=claude-sonnet-5-5

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Secreto para seudonimizar userId (correlación, no autenticación). Generar aleatorio en despliegues.
VOICE_USER_ID_SECRET=
# Secreto configurado en el post-call webhook de ElevenLabs.
ELEVENLABS_WEBHOOK_SECRET=
# Opcional: us | global | eu-residency | in-residency. No usar residencia sin workspace contratado.
ELEVENLABS_SERVER_LOCATION=
# Solo para clientes antiguos locales; deja 0 en despliegues.
ALLOW_LEGACY_SIGNED_URL=0

# Backend (arrancar desde backend/: las rutas relativas se resuelven desde ahí)
# Credenciales de POSESIÓN del prototipo local, no autenticación de identidad real.
# Obligatorio para crear clientes. Secreto aleatorio de al menos 32 caracteres, solo servidor.
# Mantenerlo entre reinicios para conservar validez; rotarlo revoca todas las credenciales.
CLIENT_ACCESS_SECRET=
# Caducidad de la credencial (8 horas por defecto). No hay renovación/reemisión por client_id.
CLIENT_ACCESS_TTL_S=28800
CORS_ORIGINS=http://localhost:3000
# Carpeta de los volcados JSON del almacén en memoria y de la base SQLite. backend/data/ está ignorada por Git.
DATA_DIR=./data
# 1 = el almacén en memoria vuelca versiones y capa personal a DATA_DIR; 0 = no escribe nada en disco.
DATA_PERSIST=1
LOAD_DEMO_FIXTURE=1

# Almacén del perfil: memoria (por defecto; desarrollo y demo sin base de datos) o bd.
PERFIL_ALMACEN=memoria
# Solo con PERFIL_ALMACEN=bd. Vacío = SQLite local en backend/data/perfil.db.
# Supabase: Connect → Session pooler (puerto 5432), con este formato y la contraseña SOLO en tu .env:
#   postgresql://postgres.<ref-del-proyecto>:<contraseña>@<host-del-pooler>:5432/postgres
# Antes de usar Supabase hay que aplicar las migraciones (ver backend/migraciones/README.md).
DATABASE_URL=
# Credencial privilegiada del servicio local: nunca se envía al navegador.
# Validación/reset fallan de forma cerrada sin configuración; no sustituye identidad del asesor.
# Las operaciones sobre memoria siguen exigiendo revisión y consentimiento también a este servicio.
# Generar uno largo y aleatorio, p. ej.: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# 1 = endpoints de demo fija y reset de servicio disponibles; 0 = desactivados.
# El frontend anónimo solo lee la fixture fija; su proxy de reset permanece bloqueado.
DEMO_ENDPOINTS=1
# Modo asesor de demostración (docs/modo-asesor-demo.md). APAGADO por defecto; solo local y clientes ficticios.
# Para el pitch: DEMO_ADVISOR_MODE=1 y el mismo DEMO_ADVISOR_TOKEN aquí y en frontend/.env.local.
# Token aleatorio de 32+ bytes, distinto de ADMIN_TOKEN, CLIENT_ACCESS_SECRET y VOICE_USER_ID_SECRET.
DEMO_ADVISOR_MODE=0
DEMO_ADVISOR_TOKEN=
# DEMO_ADVISOR_CLIENTS=carmen-68,carmen-corta
# DEMO_ADVISOR_ID=asesor-demo
# Credencial MCP de demostración (backend/app/mcp/README.md): solo lectura, solo /mcp por cabecera Bearer,
# solo desde esta máquina y solo clientes ficticios. Vacía = desactivada. 32+ bytes [A-Za-z0-9_-], distinta de
# los demás secretos. Nunca uses ADMIN_TOKEN en un conector. Los clientes nuevos se autorizan con
# scripts/demo_operador.py (token propio, que caduca y no sobrevive a un reinicio).
MCP_DEMO_TOKEN=
# MCP_DEMO_CLIENTS=carmen-68,carmen-corta
# MCP: hosts públicos permitidos (túnel o despliegue), separados por comas. Ej.: abc.trycloudflare.com
MCP_ALLOWED_HOSTS=

# Frontend: sus variables van en frontend/.env.local (ver frontend/.env.example)
