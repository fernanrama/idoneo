# Copiar a .env y rellenar en local. NUNCA subir .env al repositorio.

# Claude (Anthropic)
ANTHROPIC_API_KEY=
MODEL_EXTRACTOR=claude-sonnet-5-5
MODEL_VERIFICADOR=claude-opus-5-5

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Backend
CORS_ORIGINS=http://localhost:3000
DATA_DIR=./data
LOAD_DEMO_FIXTURE=1

# Almacén del perfil: memoria (por defecto; desarrollo y demo sin base de datos) o bd.
PERFIL_ALMACEN=memoria
# Solo con PERFIL_ALMACEN=bd. Vacío = SQLite local en backend/data/perfil.db.
# Supabase: Connect → Session pooler (puerto 5432), con este formato y la contraseña SOLO en tu .env:
#   postgresql://postgres.<ref-del-proyecto>:<contraseña>@<host-del-pooler>:5432/postgres
# Antes de usar Supabase hay que aplicar las migraciones (ver backend/migraciones/README.md).
DATABASE_URL=
# Si se define, POST /api/clients/{id}/validate y POST /api/demo/reset exigen la cabecera
# X-Admin-Token con este valor. Vacío = no se pide (desarrollo local). Obligatorio con URL pública.
# Generar uno largo y aleatorio, p. ej.: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# 1 = /api/demo/reset disponible; 0 = desactivado (recomendado en un despliegue público).
DEMO_ENDPOINTS=1
# MCP: hosts públicos permitidos (túnel o despliegue), separados por comas. Ej.: abc.trycloudflare.com
MCP_ALLOWED_HOSTS=

# Frontend: sus variables van en frontend/.env.local (ver frontend/.env.example)
